@@ -0,0 +1,56 @@
+import Foundation
+
+/**
+ * Intercepts Mapbox Directions API requests from within the Nav SDK and
+ * returns a caller-supplied canned response (the backend's eco-route matching
+ * wrapped as a Directions-shape JSON). This lets us force the SDK to build its
+ * NavigationRoutes from OUR geometry instead of re-routing between via-points.
+ *
+ * Registered once at module init via URLProtocol.registerClass. Only kicks in
+ * when `ExpoMapboxNavigationDirectionsInterceptor.pendingJson` is non-nil.
+ */
+@objc public class ExpoMapboxNavigationDirectionsInterceptor: URLProtocol {
+    /// JSON bytes the interceptor will return on the next intercepted Directions request.
+    /// Consumed once — cleared after first response so a reroute falls back to real Mapbox.
+    public static var pendingJson: Data? = nil
+    private static let interceptorHandledKey = "EcoRouteInterceptorHandled"
+
+    public override class func canInit(with request: URLRequest) -> Bool {
+        if URLProtocol.property(forKey: interceptorHandledKey, in: request) != nil {
+            return false
+        }
+        guard pendingJson != nil else { return false }
+        guard let url = request.url, let host = url.host else { return false }
+        if host != "api.mapbox.com" { return false }
+        return url.path.hasPrefix("/directions/v5/")
+    }
+
+    public override class func canonicalRequest(for request: URLRequest) -> URLRequest {
+        return request
+    }
+
+    public override func startLoading() {
+        guard let json = ExpoMapboxNavigationDirectionsInterceptor.pendingJson,
+              let url = request.url else {
+            client?.urlProtocol(self, didFailWithError: NSError(domain: "EcoRouteInterceptor", code: -1))
+            return
+        }
+
+        // Mark as handled and one-shot consume — reroutes after this hit real Mapbox.
+        ExpoMapboxNavigationDirectionsInterceptor.pendingJson = nil
+
+        print("[ExpoMapboxNavigationInterceptor] serving canned JSON for \(url.path) (\(json.count) bytes)")
+
+        let response = HTTPURLResponse(
+            url: url,
+            statusCode: 200,
+            httpVersion: "HTTP/1.1",
+            headerFields: ["Content-Type": "application/json"]
+        )!
+        client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+        client?.urlProtocol(self, didLoad: json)
+        client?.urlProtocolDidFinishLoading(self)
+    }
+
+    public override func stopLoading() {}
+}
